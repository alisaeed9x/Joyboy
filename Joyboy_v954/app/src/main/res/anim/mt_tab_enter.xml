<?xml version="1.0" encoding="utf-8"?>
<!-- (v911) نفس frostIn بتاع تبديل تبويبات شريط MeeTube: فيد من صفر + إزاحة 14dp، 320ms بمنحنى emphasized-decelerate (البلور نفسه مينفعش في انتقال النوافذ) -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/mt_emphasized_decelerate">
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="320" />
    <translate
        android:fromXDelta="14dp"
        android:toXDelta="0"
        android:duration="320" />
</set>
