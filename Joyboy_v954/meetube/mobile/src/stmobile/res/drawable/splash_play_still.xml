<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(launch): the system splash's icon, invisible on purpose: the launch animation
     (avd_splash_glass, LaunchSplash) is the only play symbol. A fully empty drawable makes the
     system fall back to the app icon, so this holds one transparent path. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="240"
    android:viewportHeight="240">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h240v240h-240z" />
</vector>
