<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(bar editor): one item of the bar in the Tabs page's stack (BarEditor): its icon, its
     name, a line on what it does, and the grip it is dragged by (a lock when it stays put). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginHorizontal="@dimen/mobile_settings_row_inset"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_bar_tile"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/bar_tile_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:tint="@color/mobile_color_on_surface" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bar_tile_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp"
            tools:text="Shorts" />

        <TextView
            android:id="@+id/bar_tile_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="12sp"
            tools:text="Tap to change" />

    </LinearLayout>

    <ImageView
        android:id="@+id/bar_tile_grip"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/ic_bar_drag"
        android:tint="@color/mobile_color_on_surface_secondary" />

</LinearLayout>
