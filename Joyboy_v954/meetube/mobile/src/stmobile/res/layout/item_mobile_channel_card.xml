<?xml version="1.0" encoding="utf-8"?>
<!--
  Channel result row (search grid, any feed that carries Video.isChannel() items).
  Pure-Material take on YouTube's channel result: round avatar + name + one quiet
  "subscribers · N videos" line. No Subscribe button here — tap opens the channel page
  (normal onVideoItemClicked routing), long-press/⋮ has Subscribe in the context menu.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/channel_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_channel_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- MEETUBE(issue #73): a channel seen live gets the glowing red ring. -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/channel_avatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_watch_channel_placeholder" />

        <com.newtube.mobile.ui.common.LiveRingView
            android:id="@+id/channel_avatar_live"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/channel_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Channel name" />

        <TextView
            android:id="@+id/channel_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="13sp"
            tools:text="1.2M subscribers · 340 videos" />

    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:alpha="0.5"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right" />

</LinearLayout>
