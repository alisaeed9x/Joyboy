<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(transcript-panel): shared search and transcript content for the panel and dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/transcript_sheet_body"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:minHeight="216dp"
    android:orientation="vertical">

    <EditText
        android:id="@+id/transcript_sheet_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/mobile_watch_pill_bg"
        android:hint="@string/mobile_transcript_search"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:textColor="@color/mobile_color_on_surface"
        android:textColorHint="@color/mobile_color_on_surface_secondary"
        android:textSize="15sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="160dp">

        <ProgressBar
            style="@style/Widget.MeeTube.GlassSpinner"
            android:id="@+id/transcript_sheet_loading"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/transcript_sheet_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/transcript_sheet_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingBottom="24dp"
            android:scrollbars="none"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
