<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="com.termux.permission.RUN_COMMAND"/>   <!-- (v365) تشغيل OmniRoute في Termux تلقائي -->
    <queries><package android:name="com.termux"/></queries>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_SETTINGS"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <application android:supportsRtl="true" android:label="مترجم الفيديو" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true" android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:theme="@style/AppSplash"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:label="الفيديو" android:icon="@mipmap/ic_launcher_video" android:roundIcon="@mipmap/ic_launcher_video">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/>
            <intent-filter><action android:name="android.intent.action.SEND"/><category android:name="android.intent.category.DEFAULT"/><data android:mimeType="text/plain"/></intent-filter>
            <intent-filter><action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/><data android:scheme="https"/><data android:host="www.youtube.com"/><data android:host="m.youtube.com"/><data android:host="youtu.be"/><data android:host="music.youtube.com"/></intent-filter>   <!-- (v345) لينكات يوتيوب تتفتح في Subtitler -->
        </activity>
        <activity android:name=".BrowserActivity" android:exported="false" android:windowSoftInputMode="adjustResize" android:theme="@style/AppSplash"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"/>
        <activity android:name=".PlayerActivity" android:exported="false"
            android:supportsPictureInPicture="true" android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"/>
        <!-- (v310) أربع أيقونات في اللانشر: الفيديو (MainActivity نفسها) · الموسيقى · المتصفح · الملفات -->
        <activity-alias android:name=".MusicLauncher" android:targetActivity=".MainActivity" android:exported="true"
            android:label="الموسيقى" android:icon="@mipmap/ic_launcher_music" android:roundIcon="@mipmap/ic_launcher_music">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".BrowserLauncher" android:targetActivity=".BrowserActivity" android:exported="true"
            android:label="المتصفح" android:icon="@mipmap/ic_launcher_browser" android:roundIcon="@mipmap/ic_launcher_browser">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".FilesLauncher" android:targetActivity=".FileManagerActivity" android:exported="true"
            android:label="الملفات" android:icon="@mipmap/ic_launcher_files" android:roundIcon="@mipmap/ic_launcher_files">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity android:name=".AiHubActivity" android:exported="false" android:windowSoftInputMode="adjustResize" android:theme="@style/AppSplash"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"/>
        <activity android:name=".TermuxConsoleActivity" android:exported="false" android:windowSoftInputMode="adjustResize" android:theme="@style/AppSplash"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"/>
        <receiver android:name=".TermuxResultReceiver" android:exported="false"/>
        <activity android:name=".LinuxConsoleActivity" android:exported="false" android:windowSoftInputMode="adjustResize" android:theme="@style/AppSplash"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"/>   <!-- (v394) كونسول Linux الداخلي -->
        <service android:name=".LinuxService" android:exported="false" android:foregroundServiceType="dataSync"/>
        <activity android:name=".FileManagerActivity" android:exported="false" android:theme="@style/AppSplash"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"/>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.fmprov"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/fm_paths"/>
        </provider>
        <activity android:name=".LiveRequestActivity" android:exported="false" android:theme="@android:style/Theme.Translucent.NoTitleBar"/>
        <service android:name=".LiveCaptionService" android:exported="false" android:foregroundServiceType="mediaProjection"/>
        <service android:name=".BgService" android:exported="false" android:foregroundServiceType="dataSync" android:stopWithTask="false"/>
        <receiver android:name=".LiveWidget" android:exported="true" android:label="🔴 ترجمة حية">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_live_info"/>
        </receiver>
        <activity android:name=".SongRequestActivity" android:exported="false" android:theme="@android:style/Theme.Translucent.NoTitleBar"/>
        <service android:name=".SongCatchService" android:exported="false" android:foregroundServiceType="mediaProjection"/>
        <service android:name=".SongNotifListener" android:exported="true" android:label="مترجم الفيديو — قراءة اسم الأغنية"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService"/></intent-filter>
        </service>
        <receiver android:name=".SongWidget" android:exported="true" android:label="🎧 تعرّف على الأغنية">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_song_info"/>
        </receiver>
        <receiver android:name=".LaunchWidget" android:exported="true" android:label="🧭 بوابات البرنامج (4 أيقونات)">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_launch_info"/>
        </receiver>
        <receiver android:name=".TasksWidget" android:exported="true" android:label="📋 مهام الخلفية">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tasks_info"/>
        </receiver>
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
        <service android:name=".YtFeedJob" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE"/>   <!-- (v327) فحص فيديوهات الاشتراكات الجديدة -->
        <service android:name=".MusicService" android:exported="false" android:foregroundServiceType="mediaPlayback"/>
        <service android:name=".KeepAliveService" android:exported="false" android:foregroundServiceType="dataSync"/>
    </application>
</manifest>
