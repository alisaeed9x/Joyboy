<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_a_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:padding="10dp"
    android:background="@drawable/widget_bg">
    <LinearLayout
        android:id="@+id/w_a_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_a_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚙ أكشنز GitHub"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/w_a_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↻ تحديث"
            android:textColor="#FFFFD54F"
            android:textSize="11sp"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_a_row0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_a_v0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1113"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/w_a_s0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⏳ شغّال"
            android:textColor="#FFFFD54F"
            android:textSize="13sp"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/w_a_t0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFE6D8C5"
            android:textSize="12sp"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_a_row1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_a_v1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1112"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/w_a_s1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="✅ نجح"
            android:textColor="#FFFFD54F"
            android:textSize="13sp"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/w_a_t1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFE6D8C5"
            android:textSize="12sp"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_a_row2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_a_v2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1111"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/w_a_s2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="❌ فشل"
            android:textColor="#FFFFD54F"
            android:textSize="13sp"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/w_a_t2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFE6D8C5"
            android:textSize="12sp"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
