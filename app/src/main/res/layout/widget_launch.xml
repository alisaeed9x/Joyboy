<?xml version="1.0" encoding="utf-8"?>
<!-- (v318) ويدجت «الأربع بوابات»: الفيديو · الموسيقى · المتصفح · الملفات — دوسة على أي أيقونة تفتح البوابة دي -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:layoutDirection="rtl"
    android:padding="6dp"
    android:background="@drawable/widget_bg">
    <LinearLayout
        android:id="@+id/w_l_video"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp">
        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_icon_bg"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_fg_video"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="الفيديو"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_l_music"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp">
        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_icon_bg"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_fg_music"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="الموسيقى"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_l_browser"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp">
        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_icon_bg"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_fg_browser"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="المتصفح"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_l_files"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp">
        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_icon_bg"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_fg_files"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="الملفات"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
