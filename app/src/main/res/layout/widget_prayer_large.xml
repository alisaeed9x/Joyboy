<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_p_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/w_p_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />
    <View
        android:id="@+id/w_p_shade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:padding="14dp">
        <TextView
            android:id="@+id/w_p_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="–:––"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/w_p_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="…"
            android:textColor="#FFD5E3F5"
            android:textSize="12sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/w_p_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 …"
            android:textColor="#FF8FB8E8"
            android:textSize="12sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/w_p_cur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="الحالية: …"
            android:textColor="#FF4DA3FF"
            android:textSize="14sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/w_p_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الصلاة الجاية: …"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1" />
        <TextView
            android:id="@+id/w_p_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="–:––"
            android:textColor="#FF4DA3FF"
            android:textSize="40sp"
            android:textStyle="bold"
            android:maxLines="1" />
        <TextView
            android:id="@+id/w_p_cd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="…"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:maxLines="1" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:layoutDirection="rtl">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/w_p_n0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الفجر" android:textColor="#FFD5E3F5" android:textSize="12sp" />
                <TextView android:id="@+id/w_p_t0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–:––" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/w_p_n1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الشروق" android:textColor="#FFD5E3F5" android:textSize="12sp" />
                <TextView android:id="@+id/w_p_t1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–:––" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/w_p_n2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الظهر" android:textColor="#FFD5E3F5" android:textSize="12sp" />
                <TextView android:id="@+id/w_p_t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–:––" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/w_p_n3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العصر" android:textColor="#FFD5E3F5" android:textSize="12sp" />
                <TextView android:id="@+id/w_p_t3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–:––" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/w_p_n4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المغرب" android:textColor="#FFD5E3F5" android:textSize="12sp" />
                <TextView android:id="@+id/w_p_t4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–:––" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/w_p_n5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العشاء" android:textColor="#FFD5E3F5" android:textSize="12sp" />
                <TextView android:id="@+id/w_p_t5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–:––" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/w_p_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="" />
    </LinearLayout>
</FrameLayout>
