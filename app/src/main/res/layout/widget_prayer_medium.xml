<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_p_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/w_p_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />
    <View
        android:id="@+id/w_p_shade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:padding="12dp">
        <TextView
            android:id="@+id/w_p_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 …"
            android:textColor="#FF8FB8E8"
            android:textSize="12sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/w_p_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الصلاة الجاية: …"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1" />
        <TextView
            android:id="@+id/w_p_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="–:––"
            android:textColor="#FF4DA3FF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:maxLines="1" />
        <TextView
            android:id="@+id/w_p_cd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="…"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/w_p_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="بجيب المواقيت…"
            android:textColor="#FFD5E3F5"
            android:textSize="12sp"
            android:maxLines="2" />
    </LinearLayout>
</FrameLayout>
