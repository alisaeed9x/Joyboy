<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppSplash" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="AppSplashMain" parent="AppSplash">
        <item name="android:windowBackground">@drawable/splash_window_joy</item>
        <item name="android:windowSplashScreenBackground">@color/joy_splash_bg</item>
    </style>
</resources>
