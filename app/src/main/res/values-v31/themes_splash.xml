<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- (v1095) كان parent = DeviceDefault (مش Material) فكل شاشة بثيم AppSplash/AppSplashMain/AppMainPlain على أندرويد 12+ مكانتش Material. اتوحّد مع values/ -->
    <style name="AppSplash" parent="Theme.NewTube">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="AppSplashMain" parent="AppSplash">
        <item name="android:windowBackground">@drawable/splash_window_joy</item>
        <item name="android:windowSplashScreenBackground">@color/joy_splash_bg</item>
    </style>
    <!-- (v922) ثيم MainActivity سادة: من غير صورة سبلاش (لا نافذة ولا سبلاش النظام) -->
    <style name="AppMainPlain" parent="AppSplash">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
    </style>
</resources>
