<?xml version="1.0" encoding="utf-8"?>
<!-- (v1148) موارد اتنقلت من ميتيوب (:mobile) قبل حذفه — الثيم/اللودرز/حركات المشغّل/الألوان اللي التطبيق لسه بيستخدمها -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <attr name="meetubeLoader" format="reference" />
    <bool name="mobile_light_system_bars">true</bool>
    <color name="meetube_glass_tint">#66FAFAFA</color>
    <color name="mobile_color_background">#FFFFFF</color>
    <color name="mobile_color_navigation_bar">#000000</color>
    <color name="mobile_color_on_surface">#0F0F0F</color>
    <color name="mobile_color_primary">#FF453A</color>
    <color name="mobile_color_primary_dark">#D7372D</color>
    <color name="mobile_color_surface">#FFFFFF</color>
    <color name="transparent">#00FFFFFF</color>
    <dimen name="meetube_sheet_max_width">640dp</dimen>
    <string name="neon_ring_path" translatable="false">M12,4 A8,8 0 1,1 12,20 A8,8 0 1,1 12,4</string>
    <style name="BrowseWindowAnimation" parent="@android:style/Animation.Activity">
            <item name="android:activityOpenEnterAnimation">@anim/browse_to_front_enter</item>
            <item name="android:activityOpenExitAnimation">@anim/mobile_stay</item>
            <item name="android:activityCloseEnterAnimation">@anim/mobile_stay</item>
            <item name="android:activityCloseExitAnimation">@anim/mobile_fade_out</item>
            <item name="android:taskOpenEnterAnimation">@anim/browse_to_front_enter</item>
            <item name="android:taskOpenExitAnimation">@anim/mobile_stay</item>
            <item name="android:taskToFrontEnterAnimation">@anim/browse_to_front_enter</item>
            <item name="android:taskToFrontExitAnimation">@anim/mobile_stay</item>
        </style>
    <style name="ShapeAppearance.MeeTube.Round" parent="">
            <item name="cornerFamily">rounded</item>
            <item name="cornerSize">16dp</item>
        </style>
    <style name="ShapeAppearance.NewTube.BottomSheet" parent="">
            <item name="cornerFamily">rounded</item>
            <item name="cornerSizeTopLeft">28dp</item>
            <item name="cornerSizeTopRight">28dp</item>
            <item name="cornerSizeBottomLeft">28dp</item>
            <item name="cornerSizeBottomRight">28dp</item>
        </style>
    <style name="TextAppearance.NewTube.Button" parent="TextAppearance.MaterialComponents.Button">
            <item name="android:textAllCaps">false</item>
            <item name="android:letterSpacing">0</item>
        </style>
    <style name="ThemeOverlay.NewTube.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
            <item name="bottomSheetStyle">@style/Widget.NewTube.BottomSheet</item>
            <!-- ElevationOverlayProvider reads this off the THEME, not off the widget style.
                 Left on, the sheet's 16dp elevation blended 14.75% white into colorSurface -
                 #1E1E1E came out as exactly #3F3F3F, which is the pale band that showed under
                 the sheet in the first place. -->
            <item name="elevationOverlayEnabled">false</item>
        </style>
    <style name="Theme.NewTube" parent="Theme.MaterialComponents.DayNight.NoActionBar">
            <!-- (v1095) ThemeEnforcement بتاع MaterialButton بيفحص colorPrimaryVariant — معرّفة صراحة عشان الفحص ما يفشلش لو الوراثة ما وصلتش (كراش MobileBrowseActivity سطر 110) -->
            <item name="colorPrimaryVariant">?attr/colorPrimary</item>
            <!-- MEETUBE(scrollbars): no scroll bar at the side of anything, sheets and dialogs included
                 (screens also turn them off at runtime: BounceOverscroll). -->
            <item name="android:scrollViewStyle">@style/Widget.MeeTube.NoScrollbars.ScrollView</item>
            <item name="android:listViewStyle">@style/Widget.MeeTube.NoScrollbars.ListView</item>
            <!-- (v888) السبلاش اتشال: أيقونة السبلاش شفافة وخلفيتها زي خلفية التطبيق وبدون مدة، فمفيش أي حاجة بتظهر قبل الرئيسية. -->
            <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_play_still</item>
            <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/mobile_color_background</item>
            <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">0</item>
            <!-- MEETUBE(loader): every circular spinner is the loader picked in Settings > Customization
                 (meetubeLoader; Loader applies the pick's overlay to each screen's theme). -->
            <item name="meetubeLoader">@drawable/avd_neon_ring</item>
            <item name="android:progressBarStyle">@style/Widget.MeeTube.Loader</item>
            <item name="android:progressBarStyleLarge">@style/Widget.MeeTube.Loader.Large</item>
            <item name="android:progressBarStyleSmall">@style/Widget.MeeTube.Loader.Small</item>
            <item name="colorPrimary">@color/mobile_color_primary</item>
            <item name="colorPrimaryDark">@color/mobile_color_primary_dark</item>
            <!-- Selection controls (checkbox, radio, switch, text caret) and any untinted
                 indeterminate ProgressBar read the accent. Left at the framework default this
                 was Material pink on a black-and-red app: the whole settings screen - section
                 headers, ticks, radio dots - came out #FF4081. Monochrome instead, per the
                 "subtle states, no tints" rule; red stays the brand/playback colour and the
                 one accent tint left is the cast-connected icon. -->
            <item name="colorAccent">@color/mobile_color_on_surface</item>
            <item name="colorSecondary">@color/mobile_color_on_surface</item>
            <item name="colorControlActivated">@color/mobile_color_on_surface</item>
            <item name="android:colorBackground">@color/mobile_color_background</item>
            <item name="colorSurface">@color/mobile_color_surface</item>
            <item name="colorOnSurface">@color/mobile_color_on_surface</item>
            <item name="android:windowBackground">@color/mobile_color_background</item>
            <!-- Solid app-colored system bars from the first frame (otherwise colorPrimaryDark red
                 flashes in the status bar until the runtime chrome in MobileActivity lands). -->
            <item name="android:statusBarColor">@color/mobile_color_background</item>
            <item name="android:navigationBarColor">@color/mobile_color_navigation_bar</item>
            <item name="android:windowLightStatusBar">@bool/mobile_light_system_bars</item>
            <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/mobile_light_system_bars</item>
            <!-- Edge-to-edge (transparent bars, content underneath) is forced from targetSdk 35 on,
                 which no-ops the fitted opaque #0F0F0F bars painted above. This attr opts out - but
                 ONLY on Android 15 and below; from Android 16 the platform ignores it and the app is
                 edge-to-edge whatever this says. Verified rather than assumed, by reading the private
                 window flags of the same build on two devices (dumpsys window windows, pfl= line):
    
                   Android 15 / API 35 (Mi 8): NO_MOVE_ANIMATION FORCE_DRAW_STATUS_BAR_BACKGROUND ...
                   Android 17 / API 37 (Pixel 9): NO_MOVE_ANIMATION EDGE_TO_EDGE_ENFORCED ...
    
                 - and a neighbouring app on the SAME Android 15 device does carry
                 EDGE_TO_EDGE_ENFORCED, so the flag's absence is this opt-out working, not the OS
                 lacking the feature. So keep it: down at minSdk 24 it is still what separates the
                 bars. What keeps modern devices right is MobileActivity.installContentInsets().
                 Same split applies to statusBarColor/navigationBarColor above. -->
            <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
            <!-- Bottom sheets. Without this, a BottomSheetDialog falls back to Material's
                 Theme.Design.Light.BottomSheetDialog - a WHITE sheet frame under our dark
                 content (hence the old "paint the frame transparent" workaround), and on the
                 fragment path an elevation overlay lightened the surface to #3F3F3F. Either
                 way the wrong colour showed through the navigation-inset padding Material adds
                 to the frame: a pale band between the sheet and the display edge. Style the
                 frame properly instead - Material paints it itself, on every layout, so a
                 background assigned in code never sticks. -->
            <item name="bottomSheetDialogTheme">@style/ThemeOverlay.NewTube.BottomSheetDialog</item>
            <item name="android:windowAnimationStyle">@style/BrowseWindowAnimation</item>
            <!-- NEWTUBE(buttons): sentence case everywhere. Material's default button text is
                 ALL CAPS with 0.09em tracking ("SIGN IN", "TRY AGAIN", "CONTINUE WITH GOOGLE") and
                 TabLayout reads the same attribute (channel tabs "NEW HERE? TRY THESE!"), next to
                 the app's own sentence-case pills ("Play all", "Subscribe"). Changing the text
                 appearance - not materialButtonStyle - keeps every button's own shape/colour. -->
            <item name="textAppearanceButton">@style/TextAppearance.NewTube.Button</item>
            <!-- NEWTUBE(snackbar): the action on the Snackbar (light on the dark theme, dark on the
                 light one) in the app's ink, not red - "Sign in" / "Undo" / "View" are choices,
                 not alarms. -->
            <item name="snackbarButtonStyle">@style/Widget.NewTube.Snackbar.Action</item>
            <!-- MEETUBE: no sharp corners - snackbars are rounded like the rest of the glass UI. -->
            <item name="snackbarStyle">@style/Widget.MeeTube.Snackbar</item>
            <!-- MEETUBE: modern capsule switches everywhere (Settings rows, dialog rows). -->
            <item name="switchStyle">@style/Widget.MeeTube.Switch</item>
        </style>
    <style name="Widget.MeeTube.Loader" parent="android:Widget.Material.ProgressBar">
            <item name="android:indeterminateDrawable">?attr/meetubeLoader</item>
        </style>
    <style name="Widget.MeeTube.Loader.Large" parent="android:Widget.Material.ProgressBar.Large">
            <item name="android:indeterminateDrawable">?attr/meetubeLoader</item>
        </style>
    <style name="Widget.MeeTube.Loader.Small" parent="android:Widget.Material.ProgressBar.Small">
            <item name="android:indeterminateDrawable">?attr/meetubeLoader</item>
        </style>
    <style name="Widget.MeeTube.NoScrollbars.ListView" parent="android:Widget.ListView">
            <item name="android:scrollbars">none</item>
        </style>
    <style name="Widget.MeeTube.NoScrollbars.ScrollView" parent="android:Widget.ScrollView">
            <item name="android:scrollbars">none</item>
        </style>
    <style name="Widget.MeeTube.Snackbar" parent="Widget.MaterialComponents.Snackbar">
            <item name="shapeAppearance">@style/ShapeAppearance.MeeTube.Round</item>
        </style>
    <style name="Widget.MeeTube.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
            <item name="useMaterialThemeColors">false</item>
            <item name="android:thumb">@drawable/meetube_switch_thumb</item>
            <item name="track">@drawable/meetube_switch_track</item>
            <item name="thumbTint">@null</item>
            <item name="trackTint">@null</item>
            <item name="android:background">@null</item>
        </style>
    <style name="Widget.NewTube.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
            <item name="backgroundTint">@color/meetube_sheet_glass</item>
            <item name="shapeAppearanceOverlay">@style/ShapeAppearance.NewTube.BottomSheet</item>
            <!-- MEETUBE: Material squares the top corners off once a sheet is expanded; keep them round. -->
            <item name="shouldRemoveExpandedCorners">false</item>
            <item name="android:maxWidth">@dimen/meetube_sheet_max_width</item>
        </style>
    <style name="Widget.NewTube.Snackbar.Action" parent="Widget.MaterialComponents.Button.TextButton.Snackbar">
            <item name="android:textColor">@color/mobile_color_background</item>
            <item name="android:fontFamily">sans-serif-medium</item>
        </style>
</resources>
