<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(issue #107): the loader - a white neon ring. A faint track, and an arc that spins,
     stretches and catches up (neon_arc), drawn as a neon tube: two wide soft strokes for the glow,
     a white core and a brighter centre. An AnimatedVectorDrawable runs on the render thread, so it
     keeps turning smoothly while the main thread lays out a page. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:pathData="@string/neon_ring_path"
                android:strokeColor="#26FFFFFF"
                android:strokeWidth="2.4" />
            <group
                android:name="spin"
                android:pivotX="12"
                android:pivotY="12">
                <path
                    android:name="halo"
                    android:pathData="@string/neon_ring_path"
                    android:strokeAlpha="0.12"
                    android:strokeColor="#FFFFFFFF"
                    android:strokeLineCap="round"
                    android:strokeWidth="8"
                    android:trimPathEnd="0.1" />
                <path
                    android:name="glow_wide"
                    android:pathData="@string/neon_ring_path"
                    android:strokeAlpha="0.22"
                    android:strokeColor="#FFFFFFFF"
                    android:strokeLineCap="round"
                    android:strokeWidth="6.2"
                    android:trimPathEnd="0.1" />
                <path
                    android:name="glow"
                    android:pathData="@string/neon_ring_path"
                    android:strokeAlpha="0.45"
                    android:strokeColor="#FFFFFFFF"
                    android:strokeLineCap="round"
                    android:strokeWidth="4.8"
                    android:trimPathEnd="0.1" />
                <path
                    android:name="core"
                    android:pathData="@string/neon_ring_path"
                    android:strokeColor="#E6FFFFFF"
                    android:strokeLineCap="round"
                    android:strokeWidth="2.8"
                    android:trimPathEnd="0.1" />
                <path
                    android:name="hot"
                    android:pathData="@string/neon_ring_path"
                    android:strokeColor="#FFFFFFFF"
                    android:strokeLineCap="round"
                    android:strokeWidth="1.2"
                    android:trimPathEnd="0.1" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="halo" android:animation="@animator/neon_arc" />
    <target android:name="glow_wide" android:animation="@animator/neon_arc" />
    <target android:name="glow" android:animation="@animator/neon_arc" />
    <target android:name="core" android:animation="@animator/neon_arc" />
    <target android:name="hot" android:animation="@animator/neon_arc" />

    <target android:name="spin">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1300"
                android:interpolator="@android:interpolator/linear"
                android:propertyName="rotation"
                android:repeatCount="infinite"
                android:valueFrom="0"
                android:valueTo="360"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
