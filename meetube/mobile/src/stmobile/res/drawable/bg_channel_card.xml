<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(channels): a channel row's card - a soft glass-toned plate with a hairline edge. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/meetube_glass_fill" />
            <stroke android:width="1dp" android:color="@color/meetube_glass_stroke" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
