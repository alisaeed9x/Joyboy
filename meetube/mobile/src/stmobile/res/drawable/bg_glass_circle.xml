<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(glass): a round glass bead behind an icon (Settings rows, the About avatar): tint,
     a sheen across its top half and a lit rim. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="270"
        android:centerColor="@color/meetube_glass_fill"
        android:endColor="@color/meetube_glass_fill"
        android:startColor="@color/meetube_glass_sheen" />
    <stroke
        android:width="1dp"
        android:color="@color/meetube_glass_rim" />
</shape>
