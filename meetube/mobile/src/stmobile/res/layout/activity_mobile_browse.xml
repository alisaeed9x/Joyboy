<?xml version="1.0" encoding="utf-8"?>
<!-- Home shell. One bottom nav (Home / Subscriptions / History / You) is the only structural
     navigation: the You tab hosts the account row, every extra BrowsePresenter section
     (Playlists, Music, ...) and the Settings entry, so there is no drawer and no settings
     icon in the top bar. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_browse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mobile_color_background">

    <!-- MEETUBE(glass): everything the floating glass blurs. The nav pill and mini player sit
         outside it (a GlassSource may not hold the GlassView that samples it). -->
    <com.newtube.mobile.ui.common.GlassSource
        android:id="@+id/mobile_blur_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mobile_color_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <!--
        No fitsSystemWindows needed: MobileActivity.applyMobileSystemBars() keeps the decor fitting
        the system windows (solid app-colored status/nav bars), so this layout never renders
        under the bars regardless of what the player did to the display in between. -->

        <!-- Pull-to-refresh drives BrowsePresenter.refresh() - also the natural retry
             gesture when a section shows the error placeholder (the error overlay doesn't
             consume touches, so the pull still reaches this layout). -->
        <com.newtube.mobile.ui.common.HapticSwipeRefreshLayout
            android:id="@+id/mobile_content_swipe"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mobile_content_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/mobile_card_spacing"
                android:paddingBottom="@dimen/meetube_nav_clearance"
                android:scrollbars="none"
                tools:listitem="@layout/item_video_card" />

        </com.newtube.mobile.ui.common.HapticSwipeRefreshLayout>

        <include
            layout="@layout/mobile_feed_skeleton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!--
             The empty/error placeholder is anchored to the title bar / bottom nav / parent
             (NOT to the content grid): when a section is empty or sign-in gated the grid is
             set GONE, and ConstraintLayout collapses any view constrained to a GONE view to
             a zero-size point - which is exactly why the signed-out Subscriptions/Playlists
             sections used to render as a blank black area with no message. Independent
             anchors keep the placeholder centered and visible over the (empty) content area.
             (First-load progress is the card skeleton above, not a spinner.)
        -->
        <LinearLayout
            android:id="@+id/mobile_error_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:paddingBottom="@dimen/meetube_nav_clearance"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/mobile_error_icon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_mobile_empty" />

            <TextView
                android:id="@+id/mobile_error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_error_action"
                style="@style/Widget.NewTube.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- "You" tab (replaces the old navigation drawer + top-bar settings icon): account row,
             every enabled BrowsePresenter section that isn't in the bottom nav, then Settings.
             Rows are inflated from item_mobile_you_row in MobileBrowseActivity.rebuildYouRows(). -->
        <ScrollView
            android:id="@+id/mobile_you_panel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/mobile_color_background"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <!-- MEETUBE(rgb glow): the RGB light in the top left, behind the header and the top pills
                 (the rows below are padded by padUnderTopBar). Its own glass source: the Accounts and
                 Settings pills frost it (they sit inside mobile_blur_target, so can't sample that). -->
            <com.newtube.mobile.ui.common.GlassSource
                android:id="@+id/mobile_you_glow_source"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:background="@color/mobile_color_background">

                <com.newtube.mobile.ui.common.RgbGlow
                    android:id="@+id/mobile_you_glow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </com.newtube.mobile.ui.common.GlassSource>

            <LinearLayout
                android:id="@+id/mobile_you_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/meetube_nav_clearance">

                <!-- Account header, as YouTube's You page has it: a big avatar, the name and the
                     email, then the Accounts and Settings pills. A tap on the header or on Accounts
                     signs in when signed out and switches accounts when signed in. -->
                <LinearLayout
                    android:id="@+id/mobile_you_account_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="12dp">

                    <!-- MEETUBE(glass): the avatar sits in a frosted disc; signed out, the disc is the avatar. -->
                    <com.newtube.mobile.ui.common.GlassView
                        android:id="@+id/mobile_you_avatar_glass"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        app:glassCornerRadius="48dp"
                        app:glassTint="@color/meetube_glass_button">

                        <ImageView
                            android:id="@+id/mobile_you_avatar"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_you_avatar" />

                    </com.newtube.mobile.ui.common.GlassView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/mobile_you_account_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/dialog_add_account"
                            android:textColor="@color/mobile_color_on_surface"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/mobile_you_account_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/mobile_color_on_surface_secondary"
                            android:textSize="14sp"
                            android:visibility="gone" />

                    </LinearLayout>

                </LinearLayout>

                <!-- MEETUBE(glass): Accounts / Settings in brighter glass than the top pills, so they
                     stand off a light page without a shadow. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <com.newtube.mobile.ui.common.GlassView
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:glassCornerRadius="22dp"
                        app:glassTint="@color/meetube_glass_button">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mobile_you_accounts"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="sans-serif-medium"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:letterSpacing="0"
                            android:text="@string/settings_accounts"
                            android:textAllCaps="false"
                            android:textColor="@color/mobile_color_on_surface"
                            android:textSize="14sp"
                            app:cornerRadius="22dp"
                            app:rippleColor="@color/mobile_color_divider" />

                    </com.newtube.mobile.ui.common.GlassView>

                    <com.newtube.mobile.ui.common.GlassView
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:glassCornerRadius="22dp"
                        app:glassTint="@color/meetube_glass_button">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mobile_you_settings"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="sans-serif-medium"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:letterSpacing="0"
                            android:text="@string/header_settings"
                            android:textAllCaps="false"
                            android:textColor="@color/mobile_color_on_surface"
                            android:textSize="14sp"
                            app:cornerRadius="22dp"
                            app:rippleColor="@color/mobile_color_divider" />

                    </com.newtube.mobile.ui.common.GlassView>

                </LinearLayout>

                <!-- History, YouTube style: a heading that opens it, then its latest videos in a
                     row that scrolls sideways (MobileBrowseActivity.loadYouHistory). -->
                <LinearLayout
                    android:id="@+id/mobile_you_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/mobile_you_history_title"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:text="@string/header_history"
                        android:textColor="@color/mobile_color_on_surface"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/mobile_you_history_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:paddingHorizontal="10dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mobile_you_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            </FrameLayout>

        </ScrollView>


        <!-- MEETUBE(shorts): the Shorts tab shows only this while its player opens. -->
        <FrameLayout
            android:id="@+id/mobile_shorts_loading"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/mobile_color_background"
            android:clickable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ProgressBar
                style="@style/Widget.MeeTube.GlassSpinner"
                android:layout_gravity="center" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    </com.newtube.mobile.ui.common.GlassSource>

    <!-- MEETUBE(you top fade): on the You page, the page colour fading down to nothing behind the
         top pills, coming in as the page scrolls, so the rows melt away under them - no bar edge,
         no blur (a full-width live frost made scrolling lag). Gradient and alpha: MobileBrowseActivity. -->
    <View
        android:id="@+id/mobile_you_top_fade"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:alpha="0"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- MEETUBE(glass): no top bar - two floating liquid-glass pills, the same glass as the nav
         capsule (Glass.blur): the brand on the left (a You sub-screen swaps it for a back arrow and
         the section's name - BrowseTopBar), cast and search on the right. The page scrolls under
         both; MobileBrowseActivity pads the lists by this row's height. -->
    <LinearLayout
        android:id="@+id/mobile_top_glass"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.newtube.mobile.ui.common.GlassView
            android:id="@+id/mobile_brand_glass"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:elevation="6dp"
            app:glassCornerRadius="22dp"
            app:glassTint="@color/meetube_glass_tint">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="16dp">

                <!-- NEWTUBE(you-subscreen): only on a section opened from a You row - BrowseTopBar. -->
                <ImageButton
                    android:id="@+id/mobile_title_back"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="-6dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mobile_dialog_back"
                    android:padding="7dp"
                    android:src="@drawable/ic_mobile_back_arrow"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/mobile_brand_mark"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_meetube_mark_default" />

                <TextView
                    android:id="@+id/mobile_title_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:maxWidth="200dp"
                    android:text="@string/app_name"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="15sp" />

            </LinearLayout>

        </com.newtube.mobile.ui.common.GlassView>

        <!-- MEETUBE(feed-strip): what Home's chips fold into while the feed scrolls back up, beside
             the brand pill (ChipBar); a tap brings the chips back. -->
        <ImageView
            android:id="@+id/mobile_chip_expand"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/mobile_feed_show_filters"
            android:elevation="6dp"
            android:scaleType="center"
            android:src="@drawable/ic_chips_expand"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.newtube.mobile.ui.common.GlassView
            android:id="@+id/mobile_actions_glass"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:elevation="6dp"
            app:glassCornerRadius="22dp"
            app:glassTint="@color/meetube_glass_tint">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingHorizontal="2dp">

                <!-- Cast picker entry on the home feed, like the official app's top bar. Tinted with the
                     accent while a session is connected (MobileBrowseActivity.updateCastIconTint). -->
                <ImageButton
                    android:id="@+id/mobile_cast_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mobile_cast_button"
                    android:padding="11dp"
                    android:src="@drawable/ic_mobile_cast" />

                <ImageButton
                    android:id="@+id/mobile_search_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:visibility="gone"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mobile_search_button"
                    android:padding="11dp"
                    android:src="@drawable/ic_mobile_search" />

            </LinearLayout>

        </com.newtube.mobile.ui.common.GlassView>

    </LinearLayout>

    <!-- MEETUBE(feed-strip): Home's topic chips, liquid-glass pills floating under the top pills;
         the feed scrolls under them (FeedStrip, the page padded by this row too).
         MEETUBE(issue #161): 4dp of headroom laid over the top row, so the chips' shadows aren't
         cut flat on top; refreshTopPadding takes it back off. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mobile_chip_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_top_glass" />

    <!-- MEETUBE(glass segmented): the same chips as one glass segment (Settings > Customization > Chips
         style); ChipBar floats whichever is picked. -->
    <com.newtube.mobile.ui.common.GlassChipTrack
        android:id="@+id/mobile_chip_track"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_nav_glass" />

    <!-- MEETUBE(quotes): the quote a tap on the brand pill shows for three seconds (QuoteCard),
         on the same liquid glass as the pills. -->
    <com.newtube.mobile.ui.common.GlassView
        android:id="@+id/mobile_quote_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:clickable="true"
        android:elevation="10dp"
        android:focusable="true"
        android:visibility="gone"
        app:glassCornerRadius="28dp"
        app:glassTint="@color/meetube_glass_tint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="22dp">

            <TextView
                android:id="@+id/mobile_quote_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="20sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/mobile_quote_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="end"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="13sp" />

        </LinearLayout>

    </com.newtube.mobile.ui.common.GlassView>

    <!-- YouTube-style FLOATING mini-player: just the live video (no bar), a rounded card
         hovering over the grid's bottom-right corner above the bottom nav. GONE by default;
         it floats OVER content (like YouTube), so the grid keeps its bottom-nav constraint.
         The video is NOT a PlayerView: the card re-parents the playback activity's
         session-long SurfaceTexture into a code-managed TextureView inside the frame below
         (see MobileBrowseActivity#attachMiniTexture + MiniPlayerBridge.getSessionTexture) -
         the codec's surface never changes, so the hand-off never freezes playback. The
         freeze ImageView shows the last captured frame during attach/detach beats.
         Tap video = expand; overlaid play/pause + X; 2dp progress. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mobile_mini_player"
        android:contentDescription="@string/mobile_mini_expand"
        android:layout_width="@dimen/meetube_mini_width"
        android:layout_height="@dimen/meetube_mini_height"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/black"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/meetube_glass_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/mobile_nav_glass"
        app:layout_constraintRight_toRightOf="parent"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- NEWTUBE(issue #9): an AspectRatioFrameLayout (FIT), given the video's shape by
                 MiniPlayerBridge.fitToVideo: other shapes are letterboxed, not stretched. -->
            <androidx.media3.ui.AspectRatioFrameLayout
                android:id="@+id/mobile_mini_player_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/mobile_mini_freeze"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:visibility="gone" />

            </androidx.media3.ui.AspectRatioFrameLayout>

            <ImageButton
                android:id="@+id/mobile_mini_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="@string/mobile_mini_play_pause"
                android:padding="9dp"
                android:src="@drawable/ic_player_pause" />

            <!-- 48dp touch target, wholly inside the card (a child outside its parent gets no touches), around the same 40dp circle (was 28dp, then 40dp - NEWTUBE(touch)). -->
            <ImageButton
                android:id="@+id/mobile_mini_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_margin="0dp"
                android:contentDescription="@string/mobile_mini_close"
                android:padding="15dp"
                android:src="@drawable/ic_sheet_close"
                android:tint="@color/mobile_player_on_video" />

            <ImageButton
                android:id="@+id/mobile_mini_audio"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|start"
                android:contentDescription="@string/mobile_player_audio_only"
                android:padding="14dp"
                android:src="@drawable/ic_player_headphones"
                android:tint="@color/mobile_player_on_video" />

            <LinearLayout
                android:id="@+id/mobile_mini_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/mobile_mini_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mobile_mini_channel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.newtube.mobile.ui.common.GlowProgressBar
                android:id="@+id/mobile_mini_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="bottom"
                android:max="1000"
                android:progressBackgroundTint="@color/mobile_color_progress_track"
                android:progressTint="@color/mobile_color_progress"
                tools:progress="400" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- MEETUBE(glass): the bottom nav floats as a blurred glass capsule over the page (Glass.blur).
         The screen's content already stops above the system navigation bar (MobileActivity insets),
         so the 12dp margin is measured from there. -->
    <com.newtube.mobile.ui.common.GlassView
        android:id="@+id/mobile_nav_glass"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="4dp"
        android:elevation="6dp"
        android:padding="6dp"
        app:glassCornerRadius="34dp"
        app:glassTint="@color/meetube_glass_tint"
        app:layout_constraintBottom_toTopOf="@id/joyboy_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="@dimen/meetube_nav_max_width">   <!-- JOYBOY(v922): شريط الرئيسية/الاشتراكات/بحث نزل تحت — فوق شريط Joyboy العايم مباشرة، وبيختفي مع السكرول لتحت وبيرجع مع السكرول لفوق (NavHider) -->

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/mobile_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:itemBackground="@drawable/bg_nav_item"
            app:itemIconSize="24dp"
            app:itemIconTint="@color/mobile_bottom_nav_item"
            app:itemRippleColor="@android:color/transparent"
            app:itemTextAppearanceActive="@style/MobileBottomNavText"
            app:itemTextAppearanceActiveBoldEnabled="false"
            app:itemTextAppearanceInactive="@style/MobileBottomNavText"
            app:itemTextColor="@color/mobile_bottom_nav_item"
            app:labelVisibilityMode="labeled"
            app:paddingBottomSystemWindowInsets="false" />

    </com.newtube.mobile.ui.common.GlassView>

    <!-- MEETUBE(search fab): a scroll down shrinks the nav bar into this Search bubble in a bottom
         corner, a scroll up stretches it back into the bar (MobileBrowseActivity.morphSearch; the
         corner is Settings > Customization's, set in code). Corners always round: a capsule at any size. -->
    <com.newtube.mobile.ui.common.GlassView
        android:id="@+id/mobile_search_fab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:contentDescription="@string/mobile_search_button"
        android:elevation="6dp"
        android:focusable="true"
        android:visibility="invisible"
        app:glassCornerRadius="999dp"
        app:glassTint="@color/meetube_glass_tint"
        app:layout_constraintBottom_toTopOf="@id/joyboy_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_mobile_search"
            android:tint="@color/mobile_color_on_surface" />

    </com.newtube.mobile.ui.common.GlassView>

    <!-- MEETUBE(nav lens, issue #46): the liquid glass lens a tab switch glides across the bar;
         sized and placed in code (NavLens.play), there only while it moves. -->
    <com.newtube.mobile.ui.common.NavLens
        android:id="@+id/mobile_nav_lens"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- MEETUBE(issue #130): a held tab's glass hint above the bar - "Tabs customization" with the
         tab names on; with them off the tab's name, and "Change" on a tab Settings can swap.
         Placed in code (showNavHint). -->
    <com.newtube.mobile.ui.common.GlassView
        android:id="@+id/mobile_nav_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:visibility="gone"
        app:glassCornerRadius="22dp"
        app:glassTint="@color/meetube_glass_tint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <TextView
                android:id="@+id/mobile_nav_hint_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="15sp"
                tools:text="Downloads" />

            <TextView
                android:id="@+id/mobile_nav_hint_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:maxLines="1"
                android:text="@string/mobile_nav_hint_change"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="13sp" />

        </LinearLayout>

    </com.newtube.mobile.ui.common.GlassView>

    <!-- MEETUBE(greeting): a held brand pill frosts the whole screen with a greeting for the time
         of day and three glass shortcuts (GreetingOverlay). A tap off the shortcuts closes it. -->
    <com.newtube.mobile.ui.common.GlassView
        android:id="@+id/mobile_greet_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:elevation="20dp"
        android:focusable="true"
        android:visibility="gone"
        app:glassCornerRadius="0dp"
        app:glassLiquid="false"
        app:glassTint="@color/meetube_glass_tint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/mobile_greet_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="40dp">

            <TextView
                android:id="@+id/mobile_greet_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="cursive"
                android:gravity="center"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="44sp"
                android:textStyle="bold"
                tools:text="Good evening" />

            <TextView
                android:id="@+id/mobile_greet_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="28dp"
                android:gravity="center"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="16sp"
                tools:text="Wind down with something good" />

        </LinearLayout>

    </com.newtube.mobile.ui.common.GlassView>

    <!-- JOYBOY(v884): حاوية شريط Joyboy السفلي — JoyboyBarHost بيحط فيها نفس BottomNav بتاع البرنامج تحت شريط MeeTube -->
    <FrameLayout
        android:id="@+id/joyboy_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
