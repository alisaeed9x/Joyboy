<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(about): the top of About - who makes MeeTube, on a glass card: the GitHub photo in a
     glass bead, the name and the GitHub handle (a tap opens the profile), the coffee pill, and Star,
     Share and Send log as glass buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/mobile_settings_row_inset"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="@dimen/mobile_settings_row_inset"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <ImageView
        android:id="@+id/about_avatar"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:background="@drawable/bg_glass_circle"
        android:importantForAccessibility="no"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:src="@drawable/about_avatar" />

    <TextView
        android:id="@+id/about_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/mobile_about_dev_name"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/about_handle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_pill"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="@string/mobile_about_dev_handle"
        android:textColor="@color/mobile_color_on_surface_secondary"
        android:textSize="13sp" />

    <!-- A little terminal window: the thank-you as a command and its output, and a blinking cursor. -->
    <LinearLayout
        android:id="@+id/about_terminal_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_about_terminal"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/about_terminal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:textColor="#E6EDF3"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="$ "
                android:textColor="#4ADE80"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/about_cursor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="▌"
                android:textColor="#4ADE80"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/about_coffee"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_glass_pill"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_settings_coffee" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/mobile_settings_coffee"
            android:fontFamily="monospace"
            android:text="@string/mobile_about_coffee_cta"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/about_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/about_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/mobile_about_star"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_glass_circle"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:src="@drawable/ic_about_star"
                android:tint="@color/mobile_color_on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="no"
                android:text="@string/mobile_about_star_short"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/about_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/mobile_about_share"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_glass_circle"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:src="@drawable/ic_about_share"
                android:tint="@color/mobile_color_on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="no"
                android:text="@string/mobile_about_share_short"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/about_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/diagnostic_log_send"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_glass_circle"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:src="@drawable/ic_about_bug_report"
                android:tint="@color/mobile_color_on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="no"
                android:text="@string/mobile_about_log_short"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
