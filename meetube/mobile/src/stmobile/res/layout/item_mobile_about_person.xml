<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(about): one person on the Contributors or Issue reporters page - GitHub photo in a
     glass bead, the GitHub name, and what they did. A tap opens their GitHub profile. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/mobile_settings_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/mobile_settings_row_inset"
    android:paddingTop="@dimen/mobile_settings_row_padding_vertical"
    android:paddingEnd="@dimen/mobile_settings_row_inset"
    android:paddingBottom="@dimen/mobile_settings_row_padding_vertical">

    <ImageView
        android:id="@+id/about_person_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_glass_circle"
        android:importantForAccessibility="no"
        android:padding="2dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/about_person_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="@dimen/mobile_settings_row_title_size" />

        <TextView
            android:id="@+id/about_person_what"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="@dimen/mobile_settings_row_summary_size" />

    </LinearLayout>

</LinearLayout>
