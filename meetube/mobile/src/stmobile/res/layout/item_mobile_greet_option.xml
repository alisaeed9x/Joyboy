<?xml version="1.0" encoding="utf-8"?>
<!-- MEETUBE(greeting): one shortcut on the greeting overlay, a glass pill on its frosted screen. -->
<com.newtube.mobile.ui.common.GlassView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="230dp"
    android:layout_height="52dp"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:glassCornerRadius="26dp"
    app:glassOnGlass="true"
    app:glassTint="@color/meetube_glass_tint">

    <TextView
        android:id="@+id/mobile_greet_option_label"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:drawablePadding="16dp"
        android:drawableTint="@color/mobile_color_on_surface"
        android:gravity="center_vertical"
        android:paddingHorizontal="22dp"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="16sp"
        tools:drawableStart="@drawable/ic_mobile_settings"
        tools:text="Settings" />

</com.newtube.mobile.ui.common.GlassView>
