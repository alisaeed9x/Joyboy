<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the You tab's list: extra browse sections (Playlists, Music, ...) plus the
     static Settings entry. Icon + label; wired programmatically in MobileBrowseActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="20dp">

    <!-- MEETUBE(glass): each icon in a frosted bubble, the glass of the Accounts pill. -->
    <com.newtube.mobile.ui.common.GlassView
        android:id="@+id/mobile_you_row_glass"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:glassCornerRadius="20dp"
        app:glassTint="@color/meetube_glass_button">

        <ImageView
            android:id="@+id/mobile_you_row_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:tint="@color/mobile_color_on_surface" />

    </com.newtube.mobile.ui.common.GlassView>

    <TextView
        android:id="@+id/mobile_you_row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="15sp" />

</LinearLayout>
